# Copy to .env. Never commit .env or paste secret values into logs/issues.

# -------------------------
# V2 application
# -------------------------
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RAW_LLM_CONTENT_RETENTION=false

# -------------------------
# V2 admin/security (required; secrets must be at least 32 random bytes)
# Generate ADMIN_PASSWORD_HASH with: cd backend && python -m app.cli hash-password
# Wrap the hash in single quotes so Compose keeps its dollar signs literal.
# -------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=
PUBLIC_TOKEN_HASH_SECRET=
RATE_LIMIT_HASH_SECRET=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# -------------------------
# V2 infrastructure
# Compose overrides service URLs to use container DNS names.
# -------------------------
POSTGRES_DB=reviewlens
POSTGRES_USER=reviewlens
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://reviewlens:change-me@localhost:5432/reviewlens
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379/0
CELERY_BROKER_URL=redis://:change-me@localhost:6379/1
CELERY_RESULT_BACKEND=
CELERY_WORKER_CONCURRENCY=4
CELERY_VISIBILITY_TIMEOUT_SECONDS=1200
RUN_EVENT_STREAM_TTL_HOURS=24
RUN_EVENT_STREAM_MAX_LENGTH=2000
RUNTIME_OUTBOX_BATCH_SIZE=50
RUNTIME_OUTBOX_LEASE_SECONDS=60
RUNTIME_TASK_LEASE_SECONDS=240
RUNTIME_RECOVERY_INTERVAL_SECONDS=30
RUNTIME_DISPATCH_LOCK_SECONDS=30

NODE_STORAGE_ROOT=/data/workspaces
NODE_QUARANTINE_ROOT=/data/quarantine
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
CONTEXT_RECONCILIATION_INTERVAL_SECONDS=300
PROJECTION_OUTBOX_BATCH_SIZE=50
PROJECTION_BACKLOG_ALERT_THRESHOLD=100
CONTEXT_NODE_PREVIEW_CHARACTERS=512

# -------------------------
# YouTube credential and locale (shared by V1 and V2)
# -------------------------
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US
YOUTUBE_RELEVANCE_LANGUAGE=en

# V2 typed research tools. The base URL may be overridden only in APP_ENV=test.
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_REQUEST_TIMEOUT_SECONDS=20
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=45
YOUTUBE_NETWORK_MAX_ATTEMPTS=3
YOUTUBE_RETRY_BASE_SECONDS=1
YOUTUBE_RETRY_MAX_SECONDS=8
YOUTUBE_SEARCH_QUERY_LIMIT=4
YOUTUBE_SEARCH_DAILY_CALL_LIMIT=100
YOUTUBE_DATA_DAILY_UNIT_LIMIT=10000
YOUTUBE_CANDIDATE_CAP=40
YOUTUBE_MIN_REVIEW_DURATION_SECONDS=180
YOUTUBE_MIN_RELEVANCE_SCORE=0.5
YOUTUBE_TRANSCRIPT_CHUNK_TARGET_CHARACTERS=6000
YOUTUBE_TRANSCRIPT_CHUNK_MAX_CHARACTERS=8000
YOUTUBE_TOOL_MAX_OUTPUT_BYTES=1000000
COMMENTS_FETCH_LIMIT=30
COMMENTS_RETAIN_LIMIT=20

# Disabled by default and still requires --confirm-live-smoke plus a video ID.
YOUTUBE_LIVE_SMOKE_ENABLED=false

# Legacy V1-only selection controls
YOUTUBE_CANDIDATE_COUNT=12
YOUTUBE_TOP_VIDEO_COUNT=3
COMMENTS_PER_VIDEO=15

# -------------------------
# OpenRouter (the only V2 inference/embedding gateway)
# -------------------------
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=ReviewLens
OPENROUTER_CATALOG_REFRESH_MINUTES=15
OPENROUTER_REQUEST_TIMEOUT_SECONDS=120
OPENROUTER_CONNECT_TIMEOUT_SECONDS=10
OPENROUTER_WRITE_TIMEOUT_SECONDS=30
OPENROUTER_POOL_TIMEOUT_SECONDS=10
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=1
OPENROUTER_RETRY_MAX_SECONDS=15
OPENROUTER_CATALOG_STALE_MINUTES=60
OPENROUTER_MANUAL_REFRESH_COOLDOWN_SECONDS=60
OPENROUTER_RECONCILIATION_INTERVAL_SECONDS=60
OPENROUTER_RECONCILIATION_MAX_AGE_MINUTES=60
OPENROUTER_RECONCILIATION_BATCH_SIZE=50
OPENROUTER_CREDIT_REFRESH_MINUTES=5

# Disabled by default. The separate live smoke script also requires explicit model slugs.
OPENROUTER_LIVE_SMOKE_ENABLED=false
OPENROUTER_SMOKE_CHAT_MODEL=
OPENROUTER_SMOKE_EMBEDDING_MODEL=
OPENROUTER_SMOKE_MAX_COST_MICROUSD=10000

# Legacy V1 model/provider controls. V2 ignores these.
OPENROUTER_MODEL=openrouter/free
XAI_API_KEY=
XAI_MODEL=grok-4.5
OPENAI_API_KEY=
OPENAI_MODEL=
AI_PRIMARY_PROVIDER=openrouter
AI_AGGREGATOR_PROVIDER=auto
AI_MAX_OUTPUT_TOKENS=3500
AI_TEMPERATURE=0.1
MAX_TRANSCRIPT_CHARS_PER_VIDEO=45000
MAX_COMMENT_CHARS_PER_VIDEO=10000

# -------------------------
# V2 seed policy defaults
# -------------------------
DEFAULT_VIDEO_COUNT=5
MIN_VIDEO_COUNT=3
MAX_VIDEO_COUNT=8
PUBLIC_RUNS_PER_HOUR=3
PUBLIC_RUNS_PER_DAY=10
PUBLIC_CONCURRENT_RUNS=2
PUBLIC_RUN_COST_CAP_USD=3
PUBLIC_DAILY_COST_CAP_USD=25
PUBLIC_ANALYSIS_ENABLED=true
