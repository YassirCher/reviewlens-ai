# -------------------------
# YouTube
# -------------------------
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_CANDIDATE_COUNT=12
YOUTUBE_TOP_VIDEO_COUNT=3
COMMENTS_PER_VIDEO=15

# -------------------------
# AI — OpenRouter
# -------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=ReviewLens POC

# -------------------------
# AI — xAI / Grok (optional)
# -------------------------
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=

# Primary provider used for per-video analysis
AI_PRIMARY_PROVIDER=openrouter
# Final consensus provider. `auto` reuses the provider selected for analysis.
AI_AGGREGATOR_PROVIDER=auto

# -------------------------
# Cost / context controls
# -------------------------
MAX_TRANSCRIPT_CHARS_PER_VIDEO=45000
MAX_COMMENT_CHARS_PER_VIDEO=10000
AI_MAX_OUTPUT_TOKENS=3500
AI_TEMPERATURE=0.1

# -------------------------
# Application
# -------------------------
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
